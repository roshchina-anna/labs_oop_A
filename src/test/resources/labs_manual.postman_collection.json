{
  "info": {
    "name": "Manual API Tests — Labs OOP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST /api/users — Register new user",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"testpass123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/users",
          "host": ["{{base_url}}"],
          "path": ["api", "users"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Response is JSON\", () => pm.response.to.be.json);",
              "const json = pm.response.json();",
              "pm.test(\"Has id, username, role\", () => {",
              "    pm.expect(json).to.have.property('id');",
              "    pm.expect(json).to.have.property('username', 'testuser');",
              "    pm.expect(json).to.have.property('role', 'USER');",
              "    pm.expect(json).to.not.have.property('passwordHash');",
              "});",
              "pm.environment.set(\"testuser_id\", json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
